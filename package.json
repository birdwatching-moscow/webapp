    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.3.1",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "zod": "^4.6.7"
  },
  "prisma": {
    "seed": "tsx --env-file=.env.local prisma/seed.ts"
