{
  "name": "birdwatching_moscow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "prisma migrate deploy && next start",
    "lint": "eslint",
    "test": "vitest",
