datasource db {
  provider = "postgresql"
  // url is configured in prisma.config.ts, not here (Prisma 7)
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum EventStatus {
  DRAFT
  ACTIVE
  PAST
  CANCELLED
  DELETED
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  FAILED
  EXPIRED
}

enum RequestType {
  EXPEDITION
  CERTIFICATE
  QUESTION
  PRIVATE_EVENT
}

enum RequestStatus {
  NEW
  WAITLIST
  OPEN
  IN_PROGRESS
  CLOSED
}

model User {
  id           String    @id @default(uuid())
  // NOTE: NOT @unique — uniqueness is a partial index WHERE "deletedAt" IS NULL, added via raw SQL in migration
  email        String    @db.VarChar(254)
  // NOTE: nullable — USER accounts are passwordless and sign in with an emailed one-time code
  passwordHash String?
  name         String    @db.VarChar(50)
  role         Role      @default(USER)
  // NOTE: forces ADMIN/SUPERADMIN password rotation after PASSWORD_MIN_LENGTH was raised to 16
  passwordResetRequired Boolean @default(false)
  // NOTE: bumped on password reset / block — every JWT carrying an older value is rejected
  sessionVersion Int @default(0)
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz
  deletedAt    DateTime? @db.Timestamptz
  blockedAt    DateTime? @db.Timestamptz

  orders               Order[]
  tickets              Ticket[]
  publishedWalks       Walk[]               @relation("WalkPublisher")
  publishedExpeditions Expedition[]         @relation("ExpeditionPublisher")
  passwordResetTokens  PasswordResetToken[]
  roleChangesAsTarget  RoleChangeLog[]      @relation("RoleChangeTarget")
  roleChangesAsChanger RoleChangeLog[]      @relation("RoleChangeChanger")
}

model Walk {
  id            String      @id @default(uuid())
  slug          String      @unique @db.VarChar(200)
  title         String      @db.VarChar(150)
  subtitle      String?     @db.VarChar(300)
  description   String      @db.Text
  startsAt      DateTime    @db.Timestamptz
  endsAt        DateTime?   @db.Timestamptz
  location      String      @db.VarChar(100)
  priceKopecks  Int
  capacity      Int
  guideId       Int
  status        EventStatus @default(DRAFT)
  coverPhotoUrl    String      @db.VarChar(2048)
  coverPhotoCredit String?     @db.VarChar(500)
  galleryUrl       String?     @db.VarChar(2048)
  emailSubject          String?  @db.VarChar(255)
  emailBody             String?  @db.Text
  reminderDaysBefore    Int?
  purchaseEmailSubject  String?  @db.VarChar(255)
  purchaseEmailBody     String?  @db.Text
  publishedAt           DateTime? @db.Timestamptz
  publishedBy   String?
  createdBy     String?     @db.VarChar(254)
  createdAt     DateTime    @default(now()) @db.Timestamptz
  updatedAt     DateTime    @updatedAt @db.Timestamptz
  updatedBy     String?     @db.VarChar(254)

  guide       TeamMember  @relation("WalkPrimaryGuide",   fields: [guideId],  references: [id])
  publisher   User?       @relation("WalkPublisher", fields: [publishedBy], references: [id])
  tickets     Ticket[]
  orderItems  OrderItem[]
  ticketTypes TicketType[]

  @@index([status, startsAt])
}

model TicketType {
  id           Int     @id @default(autoincrement())
  walkId       String
  name         String  @db.VarChar(100)
  priceKopecks Int?
  capacity     Int     @default(0)
  sortOrder    Int     @default(0)

  walk Walk @relation(fields: [walkId], references: [id])

  @@index([walkId])
}

model Expedition {
  id            String      @id @default(uuid())
  slug          String      @unique @db.VarChar(200)
  title         String      @db.VarChar(150)
  description   String      @db.Text
  startsAt      DateTime    @db.Timestamptz
  endsAt        DateTime?   @db.Timestamptz
  totalSpots    Int
  spotsLeft     Int
  status        EventStatus @default(DRAFT)
  coverPhotoUrl    String      @db.VarChar(2048)
  coverPhotoCredit String?     @db.VarChar(500)
  galleryItems     Json        @default("[]")
  checklistItems Json     @default("[]")
  durationDays   Int?
  aboutTitle     String?   @db.VarChar(200)
  aboutText      String?   @db.Text
  difficulty     Int?
  includedItems  String[]
  excludedItems  String[]
  publishedAt    DateTime? @db.Timestamptz
  publishedBy   String?
  createdBy     String?   @db.VarChar(254)
  createdAt     DateTime    @default(now()) @db.Timestamptz
  updatedAt     DateTime    @updatedAt @db.Timestamptz
  updatedBy     String?     @db.VarChar(254)

  guides      TeamMember[]
  publisher   User?                   @relation("ExpeditionPublisher", fields: [publishedBy], references: [id])
  days        ExpeditionDay[]
  ticketTypes ExpeditionTicketType[]
  requests    Request[]

  @@index([status, startsAt])
}

model ExpeditionTicketType {
  id           Int    @id @default(autoincrement())
  expeditionId String
  name         String @db.VarChar(100)
  priceKopecks Int?
  capacity     Int    @default(0)
  sortOrder    Int    @default(0)

  expedition Expedition @relation(fields: [expeditionId], references: [id])

  @@index([expeditionId])
}

model ExpeditionDay {
  id           String  @id @default(uuid())
  expeditionId String
  dayNumber    Int
  title        String  @db.VarChar(150)
  description  String  @db.Text
  photoUrl     String? @db.VarChar(2048)
  photoCredit  String? @db.VarChar(500)

  expedition Expedition @relation(fields: [expeditionId], references: [id])
}

model TeamMember {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(50)
  photoUrl     String   @db.VarChar(2048)
  education    String?  @db.Text
  achievements String?  @db.Text
  profileLinks String[]
  sortOrder    Int
  createdBy    String?  @db.VarChar(254)

  walks       Walk[]  @relation("WalkPrimaryGuide")
  expeditions Expedition[]
}

model Order {
  id                String      @id @default(uuid())
  userId            String
  status            OrderStatus @default(PENDING)
  totalKopecks      Int
  // NOTE: unique index supports idempotent webhook matching — ЮKassa may deliver the same event twice
  yooKassaPaymentId String?     @unique @db.VarChar(100)
  // End of the payment window: now + PAYMENT_HOLD_MINUTES, set at checkout. Lazy-on-read expiry.
  expiresAt         DateTime    @db.Timestamptz
  paidAt            DateTime?   @db.Timestamptz
  // Non-null flags an order for manual admin attention (amount mismatch, oversell, unexpected provider state)
  paymentIssue      String?
  createdAt         DateTime    @default(now()) @db.Timestamptz
  updatedAt         DateTime    @updatedAt @db.Timestamptz

  user       User        @relation(fields: [userId], references: [id])
  tickets    Ticket[]
  orderItems OrderItem[]

  @@index([status, expiresAt])
}

model OrderItem {
  id               String   @id @default(uuid())
  orderId          String
  walkId           String
  quantity         Int
  // Snapshot of Walk.priceKopecks at checkout time — a later admin price edit must not change an in-flight order
  unitPriceKopecks Int
  hasBinoculars    Boolean?
  createdAt        DateTime @default(now()) @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id])
  walk  Walk  @relation(fields: [walkId], references: [id])

  @@index([walkId])
}

model Ticket {
  id            String   @id @default(uuid())
  orderId       String
  userId        String
  walkId        String
  hasBinoculars Boolean?
  createdAt     DateTime @default(now()) @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
  walk  Walk  @relation(fields: [walkId], references: [id])

  @@index([userId])
}


model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AdminLoginChallenge {
  id        String    @id @default(uuid())
  email     String    @db.VarChar(254)
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  @@index([email])
}

model LoginCode {
  id String @id @default(uuid())
  // NOTE: keyed by email, not userId — the request endpoint does identical work whether or not the account exists
  email String @db.VarChar(254)
  // NOTE: deliberately NOT @unique — the 6-char space makes collisions realistic; always look up email + codeHash together
  codeHash  String    @db.VarChar(64)
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @db.Timestamptz

  @@index([email])
}

model Request {
  id           String        @id @default(uuid())
  type         RequestType
  // NOTE: set for EXPEDITION requests, null for all other types
  expeditionId String?
  name         String        @db.VarChar(100)
  email        String        @db.VarChar(254)
  message      String        @db.Text
  status       RequestStatus @default(NEW)
  createdAt    DateTime      @default(now()) @db.Timestamptz

  expedition Expedition? @relation(fields: [expeditionId], references: [id])

  @@index([status])
}

model RoleChangeLog {
  id              String   @id @default(uuid())
  targetUserId    String
  changedByUserId String
  fromRole        Role
  toRole          Role
  createdAt       DateTime @default(now()) @db.Timestamptz

  targetUser    User @relation("RoleChangeTarget", fields: [targetUserId], references: [id])
  changedByUser User @relation("RoleChangeChanger", fields: [changedByUserId], references: [id])

  @@index([targetUserId])
  @@index([createdAt])
}
